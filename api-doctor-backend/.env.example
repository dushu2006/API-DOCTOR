# ======================================================================
# API Doctor — environment configuration
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ======================================================================

# --- NVIDIA NIM (initial AI provider) ----------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model routing (exact names stay configurable — not hard-coded in code)
# Faster defaults to cut latency; override in .env if you need larger models.
INVESTIGATOR_MODEL=deepseek-ai/deepseek-v4-flash-0731
CODER_MODEL=z-ai/glm-5.2
FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
EMBEDDING_MODEL=nvidia/nv-embedcode-7b-v1

# --- GitHub integration ------------------------------------------------
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# --- Render integration -------------------------------------------------
RENDER_API_BASE_URL=https://api.render.com/v1
RENDER_API_KEY=
RENDER_SERVICE_ID=

# --- AI behaviour -------------------------------------------------------
# Overall timeout (backwards compat)
AI_TIMEOUT_SECONDS=90
# Per-request timeout for fail-fast + fallback (distinct from AI_TIMEOUT_SECONDS)
AI_REQUEST_TIMEOUT_SECONDS=35
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
# Fallback: if primary model times out / fails, retry once with FAST_MODEL
AI_MODEL_FALLBACK=true

# --- AI caching (exact cache keyed by hash(model + system + user prompt)) --
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_SIZE=128
# Optional semantic cache (needs EMBEDDING_MODEL; degrades gracefully if embeddings fail)
AI_CACHE_SEMANTIC_ENABLED=false
AI_CACHE_SEMANTIC_THRESHOLD=0.9

# --- Sandbox -------------------------------------------------------------
# docker (default) | local (fallback for environments without Docker)
SANDBOX_MODE=docker
SANDBOX_BASE_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NETWORK_ENABLED=false

# --- Repair limits --------------------------------------------------------
MAX_REPAIR_ATTEMPTS=2

# --- Code retrieval (lower defaults = less tokens = faster) ----------------
MAX_CONTEXT_FILES=4
CODE_RETRIEVAL_TOP_K=5
CONTEXT_LINE_WINDOW=12

# --- Workflow gates ---------------------------------------------------------
REQUIRE_SANDBOX=true
REQUIRE_TESTS=true
REQUIRE_VERIFICATION=true
AUTO_CREATE_PR=false
AUTO_MERGE=false
MIN_ROOT_CAUSE_CONFIDENCE=0.6

# --- Repository / demo -------------------------------------------------------
REPO_ROOT=/home/user/API-DOCTOR/api-doctor-backend
# Empty = in-process ASGI transport (self-contained demo).
# Set to the served demo API URL to detect against a deployed instance.
DEMO_API_BASE_URL=

HTTP_TIMEOUT_SECONDS=15
