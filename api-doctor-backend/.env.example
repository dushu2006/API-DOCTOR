# ======================================================================
# API Doctor — application/runtime configuration
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Project and integration credentials are configured through the UI and
# stored in the application database.
# ======================================================================

# --- Application --------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./api_doctor.db

# --- NVIDIA NIM (initial AI provider) ----------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
INVESTIGATOR_MODEL=deepseek-ai/deepseek-v4-flash-0731
CODER_MODEL=z-ai/glm-5.2
FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
EMBEDDING_MODEL=nvidia/nv-embedcode-7b-v1

# --- AI behaviour -------------------------------------------------------
AI_PROVIDER=auto
# Overall wall-clock budget for one provider chat call (all retries + fallback).
AI_TIMEOUT_SECONDS=90
# Per-attempt timeout; for streaming calls this is the idle time between chunks.
AI_REQUEST_TIMEOUT_SECONDS=35
# Stream chat completions so slow models don't trip a fixed read timeout.
AI_STREAMING=true
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
# Try FAST_MODEL automatically when the primary model fails/times out.
AI_MODEL_FALLBACK=true
# Disable chain-of-thought on structured JSON calls. Reasoning models otherwise
# burn max_tokens on thinking and return content=null (root_cause then fails).
AI_DISABLE_THINKING=true

# --- AI caching ---------------------------------------------------------
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_SIZE=128
AI_CACHE_SEMANTIC_ENABLED=false
AI_CACHE_SEMANTIC_THRESHOLD=0.9

# --- Sandbox ------------------------------------------------------------
SANDBOX_MODE=local
SANDBOX_BASE_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NETWORK_ENABLED=false

# --- Repair limits ------------------------------------------------------
MAX_REPAIR_ATTEMPTS=2

# --- Code retrieval -----------------------------------------------------
MAX_CONTEXT_FILES=4
CODE_RETRIEVAL_TOP_K=5
CONTEXT_LINE_WINDOW=12

# --- Workflow gates -----------------------------------------------------
REQUIRE_SANDBOX=true
REQUIRE_TESTS=true
REQUIRE_VERIFICATION=true
AUTO_CREATE_PR=false
AUTO_MERGE=false
MIN_ROOT_CAUSE_CONFIDENCE=0.6

# --- Runtime ------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15

# --- Demo mode ----------------------------------------------------------
# Leave false for the normal multi-project workflow.
DEMO_MODE=false
